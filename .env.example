# ---------------------------------------------------------------------------
# Momkari Yoga - production settings (NAS deployment)
#
#   cp .env.example .env      then fill in every "replace-with-..." value.
#
# .env is git-ignored. Never commit real secrets and never reuse these values
# in development.
# ---------------------------------------------------------------------------

# --- Database --------------------------------------------------------------
POSTGRES_USER=yoga_admin
# Use letters, digits, "-" and "_" only. "/", "#" and "%" break the connection
# URL that the API parses, "$" is expanded by Compose, and "&" breaks
# `source .env` inside the shell scripts. Other symbols work in the URL but are
# not worth the risk.
POSTGRES_PASSWORD=replace-with-a-long-random-password
# Rotate it later with: ./scripts/rotate-secrets.sh db   (hex is generated there)
POSTGRES_DB=yoga_app

# --- API -------------------------------------------------------------------
# Signs the admin session tokens. Generate one with: openssl rand -base64 48
JWT_SECRET=replace-with-openssl-rand-base64-48

# Extra browser origins allowed to call the API directly (LAN testing only,
# comma separated, e.g. http://192.168.1.20:5007). The public site talks to
# /api on its own origin, so it does not need an entry here.
ALLOWED_ORIGINS=

# --- Cloudflare Tunnel -----------------------------------------------------
# Cloudflare Zero Trust -> Networks -> Tunnels -> your tunnel -> install command
CLOUDFLARE_TUNNEL_TOKEN=replace-with-tunnel-token

# --- Optional LAN access ---------------------------------------------------
# Leave 127.0.0.1 to keep the container reachable only from the NAS itself.
# Set 0.0.0.0 to test http://<nas-ip>:5007 from your home network.
LAN_BIND=127.0.0.1
LAN_PORT=5007

# --- Runtime ---------------------------------------------------------------
TZ=Europe/Zurich
